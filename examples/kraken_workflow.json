{
  "_comment": "Kraken HTR workflow: Load image → Kraken BLLA line segmentation → TrOCR transcription → Text output. Node wiring: 1→2(image), 3→4(model), 2→4(cropped_lines as images), 4→5(text), 2→6(annotated_image preview).",
  "1": {
    "inputs": {
      "image": "example_suetterlin.jpg",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Handwriting Image"
    }
  },
  "2": {
    "inputs": {
      "image": [
        "1",
        0
      ],
      "device": "auto",
      "model": "default",
      "padding": 4,
      "min_width": 20,
      "min_height": 10
    },
    "class_type": "KrakenLineSegmentation",
    "_meta": {
      "title": "Kraken Line Segmentation (BLLA)",
      "note": "Outputs: [0]=cropped_lines (IMAGE batch), [1]=bboxes (JSON), [2]=count (INT), [3]=annotated_image (IMAGE)"
    }
  },
  "3": {
    "inputs": {
      "model_name": "dh-unibe/trocr-kurrent",
      "device": "auto",
      "dtype": "auto",
      "auto_download": true
    },
    "class_type": "LoadTrOCRModel",
    "_meta": {
      "title": "Load TrOCR Model (Kurrent/Sütterlin)"
    }
  },
  "4": {
    "inputs": {
      "model": [
        "3",
        0
      ],
      "images": [
        "2",
        0
      ],
      "max_length": 256,
      "separator": "\n"
    },
    "class_type": "BatchTrOCRInference",
    "_meta": {
      "title": "Batch TrOCR Inference",
      "note": "Receives cropped line images from KrakenLineSegmentation output [0]"
    }
  },
  "5": {
    "inputs": {
      "text": [
        "4",
        0
      ],
      "save_to_file": false,
      "output_path": "transcription.txt",
      "format": "txt"
    },
    "class_type": "TextOutput",
    "_meta": {
      "title": "Transcription Output",
      "note": "Set save_to_file=true and output_path to a filename (e.g. transcription.txt) to save results to disk"
    }
  },
  "6": {
    "inputs": {
      "images": [
        "2",
        3
      ]
    },
    "class_type": "PreviewImage",
    "_meta": {
      "title": "Annotated Lines Preview",
      "note": "Shows detected line polygons overlaid on the original image. Uses KrakenLineSegmentation output [3]=annotated_image"
    }
  }
}
